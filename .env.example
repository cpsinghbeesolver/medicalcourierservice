APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@reliatrack.com"
MAIL_FROM_NAME="${APP_NAME}"

# Admin email for form notifications
MAIL_ADMIN_EMAIL="admin@reliatrack.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Maps API Key (Get free key at: https://console.cloud.google.com/)
GOOGLE_MAPS_API_KEY=

# ===================================================
# HIPAA COMPLIANCE CONFIGURATION
# ===================================================

# Enable HIPAA compliance mode (encryption + audit logging)
HIPAA_COMPLIANCE_ENABLED=true

# Data Retention (in days) - HIPAA requires 6 years minimum
HIPAA_AUDIT_LOG_RETENTION_DAYS=2190
HIPAA_DELIVERY_RETENTION_DAYS=2190
HIPAA_USER_DATA_RETENTION_DAYS=2190

# Audit Logging
HIPAA_LOG_ALL_PHI_ACCESS=true
HIPAA_LOG_AUTHENTICATION=true
HIPAA_LOG_UNAUTHORIZED=true
HIPAA_ALERT_SUSPICIOUS=true

# Encryption
HIPAA_ENCRYPTION_ENABLED=true

# Session Management (minutes) - HIPAA recommends 15 minutes or less
HIPAA_SESSION_TIMEOUT=15

# Multi-Factor Authentication
HIPAA_REQUIRE_MFA=false

# Breach Notification
HIPAA_BREACH_NOTIFICATION_ENABLED=true
HIPAA_BREACH_NOTIFICATION_EMAIL=compliance@example.com

# Database Security
DB_REQUIRE_SSL=false  # Set to true in production
DB_BACKUP_ENCRYPTION_ENABLED=true
DB_TDE_ENABLED=false

# De-identification (for analytics/reporting)
HIPAA_DEIDENTIFICATION_ENABLED=true
